var radius = 40;
var forgotten = "never used";

function flower(petals, size) {
    for (i in 0...petals) {
        var angle = i / petals * Math.PI * 2;
        circle(200 + Math.cos(angle) * size, 200 + Math.sin(angle) * size, radius / 2);
    }
    circle(200, 200, raduis / 3, 0xffd54f);
}

clear(0x1e1e1e);
flower(8, 60);
